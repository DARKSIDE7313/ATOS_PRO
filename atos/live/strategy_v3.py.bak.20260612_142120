# ENHANCED — multi-timeframe signal source for ATOS factor engine.
# BUGFIX 2026-06-11: 移除5m/1h的yfinance请求（180次API调用太慢），
#                   改为用日线数据的多种窗口期计算近似多时间框架信号。

"""
ATOS PRO v3 — 短期策略引擎（重写版v2）
==================================
轻量化多时间框架信号 — 只用日线数据，无额外API请求。

用不同时间窗口的移动平均交叉模拟5m/1h/1d信号：
  - 短期: 5日均线 vs 10日均线（模拟5分钟动量）
  - 中期: 20日均线 vs 50日均线（模拟1小时趋势）
  - 长期: 价格 vs MA200（日线趋势确认）

信号权重随市场状态自动调整：
  BULL: 动量40% 趋势30% 突破20% 反转10%
  BEAR: 反转30% 价值30% 趋势20% 动量20%
  HIGH_VOL: 反转40% 价值30% 趋势20% 动量10%
"""

import pandas as pd
import numpy as np
from atos.core.logging import get_logger

logger = get_logger("strategy_v3")

# 信号权重矩阵
WEIGHT_MATRIX = {
    "BULL_STRONG": {"momentum":0.40,"trend":0.30,"breakout":0.20,"reversal":0.10},
    "BULL_WEAK":   {"momentum":0.30,"trend":0.25,"breakout":0.15,"reversal":0.30},
    "HIGH_VOL":    {"momentum":0.20,"trend":0.30,"breakout":0.20,"reversal":0.30},  # reversal from 0.60→0.30
    "BEAR":        {"momentum":0.15,"trend":0.35,"breakout":0.30,"reversal":0.20},  # reversal from 0.50→0.20
    "UNKNOWN":     {"momentum":0.25,"trend":0.25,"breakout":0.25,"reversal":0.25},
}


def multi_timeframe_signal(df: pd.DataFrame) -> dict:
    """从日线K线数据提取多时间框架信号（无需额外API调用）。

    用不同窗口长度的移动平均线模拟多时间框架分析：
    - fast_ma (5日 vs 10日) → 短期动量
    - med_ma (20日 vs 50日) → 中期趋势
    - long_ma (价格 vs MA200) → 长期确认
    """
    try:
        if df.empty or len(df) < 50:
            return {}

        if isinstance(df.columns, pd.MultiIndex):
            df.columns = [c[0] for c in df.columns]

        close = df["Close"].squeeze()
        
        signals = {}

        # 短期动量（5日均线 vs 10日均线）
        if len(close) >= 10:
            ma5 = close.rolling(5).mean()
            ma10 = close.rolling(10).mean()
            mom_short = float((ma5.iloc[-1] - ma10.iloc[-1]) / ma10.iloc[-1]) if ma10.iloc[-1] > 0 else 0
            signals["s_momentum"] = round(mom_short, 4)
            signals["s_trend"] = "UP" if ma5.iloc[-1] > ma10.iloc[-1] else "DOWN"

        # 中期趋势（20日均线 vs 50日均线）
        if len(close) >= 50:
            ma20 = close.rolling(20).mean()
            ma50 = close.rolling(50).mean()
            price = float(close.iloc[-1])
            trend_strength = abs(price - ma20.iloc[-1]) / ma20.iloc[-1] if ma20.iloc[-1] > 0 else 0
            signals["m_trend"] = "UP" if price > ma20.iloc[-1] > ma50.iloc[-1] else \
                                 "DOWN" if price < ma20.iloc[-1] < ma50.iloc[-1] else "NEUTRAL"
            signals["m_strength"] = round(trend_strength, 4)
            signals["m_ma20_dist"] = round((price - ma20.iloc[-1]) / ma20.iloc[-1], 4) if ma20.iloc[-1] > 0 else 0

        # 长期确认（RSI + MACD）
        if len(close) >= 26:
            rsi = _rsi_val(close)
            signals["l_rsi"] = round(rsi, 1)
            signals["l_rsi_signal"] = "OVERBOUGHT" if rsi > 70 else \
                                      "OVERSOLD" if rsi < 30 else "NORMAL"
            # MACD
            ema12 = close.ewm(span=12).mean()
            ema26 = close.ewm(span=26).mean()
            macd = ema12 - ema26
            signal = macd.ewm(span=9).mean()
            signals["l_macd_hist"] = float((macd - signal).iloc[-1])

        return signals
    except Exception as e:
        logger.debug(f"multi_timeframe_signal failed: {e}")
        return {}


def _rsi_val(series, period=14):
    delta = series.diff()
    gain = delta.clip(lower=0).rolling(period).mean()
    loss = (-delta.clip(upper=0)).rolling(period).mean()
    rs = gain / loss.replace(0, 1e-9)
    return float(100 - (100 / (1 + rs)).iloc[-1])


def composite_signal(symbol: str, regime: str, signals: dict) -> dict:
    """多信号融合 → 单一决策（从 signals 中的数据直接计算，不加新API）。"""
    weights = WEIGHT_MATRIX.get(regime, WEIGHT_MATRIX["UNKNOWN"])
    mtf = signals  # 从已有 signals dict 中读取所有必要字段

    score = 0.5
    reasons = []

    # 短期动量（来自5/10日均线差）
    s_mom = mtf.get("s_momentum", 0)
    if s_mom > 0.005:
        score += weights["momentum"] * 0.3
        reasons.append(f"s_mom+{s_mom:.1%}")
    elif s_mom < -0.005:
        score -= weights["momentum"] * 0.3
        reasons.append(f"s_mom{s_mom:.1%}")

    # 中期趋势
    m_trend = mtf.get("m_trend", "NEUTRAL")
    if m_trend == "UP":
        score += weights["trend"] * 0.25
        reasons.append("m_trend=UP")
    elif m_trend == "DOWN":
        score -= weights["trend"] * 0.25
        reasons.append("m_trend=DOWN")

    # 长期 RSI
    l_rsi = mtf.get("l_rsi", 50)
    if l_rsi < 30:
        score += weights["reversal"] * 0.3
        reasons.append(f"RSI={l_rsi:.0f}超卖")
    elif l_rsi > 70:
        score -= weights["breakout"] * 0.2
        reasons.append(f"RSI={l_rsi:.0f}超买")

    # 日线趋势确认（从 signal_engine 的 trend 字段）
    trend = signals.get("trend", "NEUTRAL")
    if trend == "UP":
        score += 0.05
    elif trend == "DOWN":
        score -= 0.05

    # 布林带
    bb = signals.get("bollinger", {}).get("pct_b", 0.5)
    if bb < 0.2:
        score += weights["reversal"] * 0.2  # 超卖反弹
        reasons.append("bb超卖")
    if bb > 0.8:
        score -= weights["breakout"] * 0.15
        reasons.append("bb超买")

    score = max(0.05, min(0.95, score))

    decision = "BUY" if score > 0.60 else ("SELL" if score < 0.35 else "HOLD")

    return {
        "symbol": symbol,
        "score": round(score, 3),
        "decision": decision,
        "weights_used": weights,
        "reasons": reasons[:5],
        "multi_timeframe": mtf,
    }


def get_v3_signals(symbols: list[str], regime: str = "UNKNOWN") -> dict:
    """
    从 signal_engine 已有的数据中计算多时间框架信号。
    BUGFIX 2026-06-11: 不再单独调 yfinance（太慢），
                      所有分析基于 signal_engine 的 signals dict。
    
    返回 {symbol: {composite, decision, multi_timeframe, reasons}} 格式
    供 combine() 作为第5因子 "multiframe" 使用。
    """
    logger.info(f"v3多时间框架信号: 将从已有信号数据计算 {len(symbols)} 只")
    # 注意：实际使用时，composite_signal 需要从 signal_engine 的 signals dict 读取数据
    # 这里由调用方（combine）传入正确的 signals
    return {sym: {"composite": 0.5, "decision": "HOLD", "multi_timeframe": {}}
            for sym in symbols}
